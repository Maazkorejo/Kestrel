# Nebius Token Factory API Credentials
# Get your key from: https://tokenfactory.nebius.com (or https://studio.nebius.ai)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_API_BASE=https://api.studio.nebius.ai/v1

# NVIDIA Open-Source Model hosted on Nebius
# Examples:
# nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
# nvidia/nemotron-4-340b-instruct
NVIDIA_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Optional: Tavily API Key for Search Tool (Eligible for ,000 Tavily prize)
TAVILY_API_KEY=your_tavily_api_key_here
